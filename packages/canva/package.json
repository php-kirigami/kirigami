{
  "name": "@kirigami/canva",
  "version": "1.1.0",
  "description": "Shared Sass and browser-JS design system for Kirigami projects: design tokens, an inline-SVG icon system, pure Sass utilities, and small DOM helpers.",
  "license": "MIT",
  "author": "Maxime Larrivée-Roy",
  "type": "module",
  "sideEffects": [
    "./dist/scripts/dom.js",
    "./dist/scripts/theme.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./scripts/*": {
      "types": "./dist/scripts/*.d.ts",
      "import": "./dist/scripts/*.js"
    },
    "./styles/*": "./dist/styles/*.scss"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "prepublishOnly": "node build.js"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.2.3"
  },
  "devDependencies": {
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.2",
    "fast-glob": "^3.3.3"
  }
}
