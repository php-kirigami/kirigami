{
  "name": "@kirigami/kirigami",
  "version": "2.1.0",
  "description": "Tools to build static website with PHP",
  "keywords": ["static-site","php","kirigami","ssg","php-wasm"],
  "license": "GPL-3.0-or-later",
  "author": "Maxime Larrivée-Roy",
  "homepage": "https://php-kirigami.github.io",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "bin/",
    "assets/",
    "LICENSE",
    "README.md",
    "kirigami.schema.json"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.2.3"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./package.json": "./package.json",
    "./schema": "./kirigami.schema.json",
    "./internal/config": "./bin/config.js",
    "./internal/tasks/*": "./bin/tasks/*.js",
    "./internal/plugins": "./bin/libs/plugins.js",
    "./internal/watchengine": "./bin/libs/watchengine.js",
    "./internal/runscript": "./bin/libs/runscript.js",
    "./internal/devserver": "./bin/libs/devserver.js",
    "./internal/phpinfoparser": "./bin/libs/phpinfoparser.js",
    "./internal/utils": "./bin/utils.js"
  },
  "dependencies": {
    "@kirigami/canva": "2.6.0",
    "@kirigami/php-prepros": "2.0.0",
    "@kirigami/sdk": "0.2.1",
    "@kirigami/struct-walker": "1.0.5",
    "ajv": "^8.20.0",
    "chokidar": "^5.0.0",
    "csso": "^5.0.5",
    "esbuild": "^0.28.2",
    "fontkit": "^2.0.4",
    "ignore": "^7.0.9",
    "picomatch": "^4.0.7",
    "sass": "^1.104.1"
  }
}
