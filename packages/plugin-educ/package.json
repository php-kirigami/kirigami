{
  "name": "@kirigami/plugin-educ",
  "version": "0.2.1",
  "description": "Authoring tags for course pages in Kirigami — starting with <checklist>, a progress-tracked checklist remembered in the reader's browser.",
  "keywords": [
    "kirigami",
    "kirigami-plugin",
    "plugin",
    "education",
    "course",
    "checklist"
  ],
  "license": "GPL-3.0-or-later",
  "author": "Maxime Larrivée-Roy",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "php/",
    "src/",
    "assets/",
    "options.schema.json",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "kirigami": {
    "type": "plugin",
    "minVersion": "3.0.0",
    "optionsSchema": "./options.schema.json"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.2.3"
  },
  "dependencies": {
    "@kirigami/sdk": "0.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/php-kirigami/kirigami.git"
  },
  "homepage": "https://php-kirigami.github.io",
  "bugs": {
    "url": "https://github.com/php-kirigami/kirigami/issues"
  }
}
