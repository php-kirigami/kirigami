{
  "name": "@kirigami/mcp",
  "version": "0.1.1",
  "description": "MCP server exposing a Kirigami project (build/export/validate/run) as tools for an AI agent.",
  "keywords": [
    "kirigami",
    "mcp",
    "model-context-protocol",
    "static-site-generator",
    "ai-agent"
  ],
  "license": "GPL-3.0-or-later",
  "author": "Maxime Larrivée-Roy",
  "homepage": "https://php-kirigami.github.io",
  "type": "module",
  "main": "index.js",
  "bin": {
    "kiri-mcp": "./bin/kiri-mcp.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.js",
    "lib/",
    "bin/",
    "LICENSE",
    "README.md"
